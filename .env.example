APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite+pysqlite:///./var/mutiai.db
DATABASE_AUTO_MIGRATE=true
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-network-access
SESSION_COOKIE_NAME=mutiai_session
SESSION_TTL_SECONDS=604800
MUTIAI_RUNTIME_WORKSPACE_ROOT=G:\AI\AI_private\mutiAI-runtime-workspaces
