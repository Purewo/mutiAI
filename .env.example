APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite+pysqlite:///./var/mutiai.db
DATABASE_AUTO_MIGRATE=true
LANGGRAPH_CHECKPOINT_PATH=./var/langgraph-checkpoints.db
RUNTIME_PROVIDER=fake
RUNTIME_DEFAULT_BINDING_KEY=codex-local-default
# First-week localhost demo only. Production must use workspace_restricted.
RUNTIME_SECURITY_MODE=demo_full_access
# Disabled by default. Set an integer to rotate a role Thread after that many
# observed Codex context compactions; the Workspace and delivery summary remain.
# RUNTIME_THREAD_MAX_COMPACTIONS=3
RUNTIME_MAX_CONCURRENT_EXECUTIONS=2
RUNTIME_PROVIDER_CAPACITY_CACHE_SECONDS=30
# Product token budgets are disabled unless both values are set.
# RUNTIME_TOKEN_BUDGET_LIMIT=200000
# RUNTIME_TOKEN_RESERVATION_PER_EXECUTION=50000
CODEX_APP_SERVER_ENDPOINT=ws://127.0.0.1:4500
CODEX_APP_SERVER_READY_TIMEOUT_SECONDS=5
# Optional fallback values used when the default binding is first created.
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=medium
# The platform assistant can inherit the task Runtime, remain fake for contract
# work, or use an independent Codex adapter against the same supervised sidecar.
ASSISTANT_RUNTIME_PROVIDER=inherit
# ASSISTANT_MODEL=gpt-5.5
# ASSISTANT_REASONING_EFFORT=medium
# ASSISTANT_THREAD_MAX_COMPACTIONS=3
ASSISTANT_TOOL_CONTRACT_VERSION=1.1
# Product-owned chat uploads stay outside source repositories and Runtime Workspaces.
# ASSISTANT_ATTACHMENT_ROOT=G:\AI\AI_private\mutiAI-assistant-attachments
ASSISTANT_ATTACHMENT_MAX_BYTES=10485760
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-network-access
SESSION_COOKIE_NAME=mutiai_session
SESSION_TTL_SECONDS=604800
MUTIAI_RUNTIME_WORKSPACE_ROOT=G:\AI\AI_private\mutiAI-runtime-workspaces
