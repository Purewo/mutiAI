{
  "$defs": {
    "AgentRoleSpec": {
      "additionalProperties": false,
      "description": "One persistent formal role in an organization definition.",
      "properties": {
        "role_key": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Role Key",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "responsibility": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Responsibility",
          "type": "string"
        },
        "is_lead": {
          "default": false,
          "title": "Is Lead",
          "type": "boolean"
        },
        "reports_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reports To"
        },
        "runtime_binding_key": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Runtime Binding Key",
          "type": "string"
        },
        "capability_requirements": {
          "$ref": "#/$defs/WorkloadRequirements"
        }
      },
      "required": [
        "role_key",
        "name",
        "responsibility",
        "runtime_binding_key"
      ],
      "title": "AgentRoleSpec",
      "type": "object"
    },
    "WorkloadRequirements": {
      "additionalProperties": false,
      "description": "Capabilities required by one role or one submitted workload.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "os_families": {
          "default": [],
          "items": {
            "enum": [
              "linux",
              "windows",
              "macos"
            ],
            "type": "string"
          },
          "title": "Os Families",
          "type": "array"
        },
        "requires_gui": {
          "default": false,
          "title": "Requires Gui",
          "type": "boolean"
        },
        "requires_gpu": {
          "default": false,
          "title": "Requires Gpu",
          "type": "boolean"
        },
        "min_gpu_memory_mb": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Gpu Memory Mb"
        },
        "min_cpu_capacity": {
          "default": "light",
          "enum": [
            "light",
            "standard",
            "heavy"
          ],
          "title": "Min Cpu Capacity",
          "type": "string"
        },
        "min_memory_mb": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Memory Mb"
        },
        "required_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Tools",
          "type": "array"
        },
        "requires_network": {
          "default": false,
          "title": "Requires Network",
          "type": "boolean"
        },
        "required_external_services": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required External Services",
          "type": "array"
        },
        "required_hardware": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Hardware",
          "type": "array"
        },
        "required_proprietary_software": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Proprietary Software",
          "type": "array"
        },
        "input_media_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Media Types",
          "type": "array"
        },
        "output_media_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Output Media Types",
          "type": "array"
        },
        "estimated_duration_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Duration Seconds"
        },
        "estimated_input_size_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Input Size Bytes"
        },
        "resource_intensive": {
          "default": false,
          "title": "Resource Intensive",
          "type": "boolean"
        }
      },
      "title": "WorkloadRequirementsV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A versioned, portable organization definition for the V1 tree model.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/AgentRoleSpec"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Roles",
      "type": "array"
    }
  },
  "required": [
    "name",
    "roles"
  ],
  "title": "OrganizationSpecV1",
  "type": "object"
}
