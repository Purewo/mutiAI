          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description",
            "default": ""
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/AgentRoleSpec"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Roles"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "roles"
        ],
        "title": "OrganizationSpecV1",
        "description": "A versioned, portable organization definition for the V1 tree model."
      },
      "OrganizationSummaryResponse": {
        "properties": {
          "organization_id": {
            "type": "string",
            "title": "Organization Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "current_published_version_id": {
