        "type": "string",
        "enum": [
          "proposal",
          "confirmed",
          "published",
          "superseded",
          "archived"
        ],
        "title": "OrganizationVersionStatus"
      },
      "UserResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
