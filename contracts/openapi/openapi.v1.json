          },
          "organization_id": {
            "type": "string",
            "title": "Organization Id"
          },
          "version_number": {
            "type": "integer",
            "title": "Version Number"
          },
          "status": {
            "$ref": "#/components/schemas/OrganizationVersionStatus"
          },
          "spec": {
            "$ref": "#/components/schemas/OrganizationSpec"
          },
          "source_request": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Request"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "confirmed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
