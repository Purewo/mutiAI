            "minLength": 1,
            "title": "Role Key"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "responsibility": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Responsibility"
          },
          "is_lead": {
            "type": "boolean",
            "title": "Is Lead",
            "default": false
