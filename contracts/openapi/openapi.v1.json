          "runtime_binding_key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Runtime Binding Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role_key",
          "name",
          "responsibility",
          "runtime_binding_key"
        ],
        "title": "AgentRoleSpec",
        "description": "One persistent formal role in an organization definition."
      },
      "ErrorEnvelope": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
